<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- BD aislada: se BORRA y recrea en cada ejecución de las pruebas -->
    <add name="ReservasUTP_Pruebas"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ReservasUTP_Pruebas;Integrated Security=True;Connect Timeout=15"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
