<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Opción por defecto: SQL Server LocalDB (incluido con Visual Studio) -->
    <add name="ReservasUTP"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ReservasUTP;Integrated Security=True;Connect Timeout=15"
         providerName="System.Data.SqlClient" />
    <!-- SQL Server Express:  Data Source=.\SQLEXPRESS;Initial Catalog=ReservasUTP;Integrated Security=True -->
    <!-- Autenticación SQL:    Data Source=localhost;Initial Catalog=ReservasUTP;User ID=sa;Password=TuClave -->
  </connectionStrings>
</configuration>
